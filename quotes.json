name: Обновление котировок

on:
  schedule:
    - cron: "*/30 7-16 * * 1-5"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: quotes
  cancel-in-progress: false

jobs:
  update:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Версия workflow
        run: echo ">>> ВЕРСИЯ 3 <<< если этой строки нет в логе - запустился старый файл"

      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Собрать котировки
        run: python fetch_quotes.py

      - name: Закоммитить результат
        run: |
          git config user.name  "quotes-bot"
          git config user.email "quotes-bot@users.noreply.github.com"
          BRANCH="${GITHUB_REF_NAME}"

          for i in 1 2 3; do
            echo "--- попытка $i ---"

            # Встаём ровно на текущее состояние репозитория,
            # сохраняя посчитанные файлы в рабочей папке.
            git fetch origin "$BRANCH"
            git reset "origin/$BRANCH"

            git add quotes.json quotes.md
            if git diff --staged --quiet; then
              echo "Изменений нет, коммит не нужен"
              exit 0
            fi

            git commit -m "Котировки на $(date -u '+%Y-%m-%d %H:%M UTC')"

            if git push origin "HEAD:$BRANCH"; then
              echo "Отправлено с попытки $i"
              exit 0
            fi

            echo "Не прошло, пробую снова через 5 секунд..."
            sleep 5
          done

          echo "Не удалось отправить результат за три попытки"
          exit 1
