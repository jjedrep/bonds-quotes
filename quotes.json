name: Обновление котировок

on:
  # Каждые 30 минут в торговые часы Мосбиржи (10:00-19:00 МСК = 07:00-16:00 UTC),
  # по будням. Время в cron всегда UTC.
  schedule:
    - cron: "*/30 7-16 * * 1-5"
  # Кнопка "Run workflow" во вкладке Actions - для запуска руками
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: quotes
  cancel-in-progress: false

jobs:
  update:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - uses: actions/checkout@v4
        with:
          # полная история - нужна, чтобы корректно подтянуть чужие коммиты
          fetch-depth: 0

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Собрать котировки
        run: python fetch_quotes.py

      - name: Закоммитить результат
        run: |
          git config user.name  "quotes-bot"
          git config user.email "quotes-bot@users.noreply.github.com"

          git add quotes.json quotes.md
          if git diff --staged --quiet; then
            echo "Изменений нет, коммит не нужен"
            exit 0
          fi

          git commit -m "Котировки на $(date -u '+%Y-%m-%d %H:%M UTC')"

          # Если за время работы в репозиторий что-то попало - подтягиваем
          # свежее состояние и пробуем снова. Пять попыток с паузой.
          for i in 1 2 3 4 5; do
            if git push; then
              echo "Отправлено с попытки $i"
              exit 0
            fi
            echo "Попытка $i не прошла, подтягиваю свежее состояние..."
            git pull --rebase --autostash origin "${GITHUB_REF_NAME}" || {
              echo "Конфликт - оставляю свою версию файлов"
              git checkout --ours quotes.json quotes.md 2>/dev/null || true
              git add quotes.json quotes.md
              GIT_EDITOR=true git rebase --continue || git rebase --abort
            }
            sleep 5
          done

          echo "Не удалось отправить результат за пять попыток"
          exit 1
